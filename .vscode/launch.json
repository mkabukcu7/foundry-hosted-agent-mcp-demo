{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Vendor Contract Assurance",
      "type": "debugpy",
      "request": "launch",
      "module": "agent.contract_assurance",
      "python": "${workspaceFolder}\\agent\\.venv\\Scripts\\python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "CONTRACT_ASSURANCE_LOCAL": "1",
        "PORT": "8090",
        "CONTRACT_ANALYST_URL": "http://127.0.0.1:8091/",
        "RFP_ANALYST_URL": "http://127.0.0.1:8092/"
      }
    },
    {
      "name": "Debug HWC Hosted Agent",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5679
      },
      "preLaunchTask": "Open Agent Inspector",
      "internalConsoleOptions": "neverOpen",
      "postDebugTask": "Terminate All Tasks"
    }
  ]
}